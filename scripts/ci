#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

node_run() {
  local command="$1"
  if [[ "${CI_RUNTIME:-docker}" == "host" ]]; then
    bash -lc "$command"
    return
  fi

  docker run --rm --user "$(id -u):$(id -g)" \
    -e COREPACK_HOME=/tmp/corepack \
    -e NUXT_SESSION_PASSWORD=ci-only-session-password-with-at-least-32-characters \
    -v "$root:/workspace" -w /workspace node:24.11-bookworm \
    bash -lc "corepack enable && $command"
}

frontend() { node_run 'pnpm install --frozen-lockfile && pnpm lint'; }
backend() {
  composer --working-dir=apps/identity-server validate --strict
  composer --working-dir=apps/identity-server install --prefer-dist --no-interaction --no-progress
  composer --working-dir=apps/identity-server lint
  composer --working-dir=apps/identity-server test
}
security() {
  ./scripts/check-tracked-secrets.sh
  IDENTITY_ENV_FILE=.env.production.example docker compose --env-file .env.production.example config --quiet
  node_run 'pnpm install --frozen-lockfile && pnpm audit --prod'
  composer --working-dir=apps/identity-server audit
}
images() {
  for dockerfile in docker/identity-server/Dockerfile docker/identity-server/nginx.Dockerfile docker/identity-console/Dockerfile; do
    image "$dockerfile"
  done
}
image() { docker build --file "$1" --tag "local/ci-$(basename "$(dirname "$1")")-$(basename "$1")" .; }
dco() { ./scripts/check-dco.sh "${1:-origin/main}"; }

case "${1:-fast}" in
  frontend) frontend ;;
  build) node_run 'pnpm build' ;;
  backend) backend ;;
  security) security ;;
  images) images ;;
  dco) dco "${2:-origin/main}" ;;
  fast) dco; frontend; backend; security ;;
  full) dco; frontend; backend; security; node_run 'pnpm build'; images ;;
  image) image "${2:?Dockerfile required}" ;;
  *) echo "Usage: $0 {fast|full|frontend|build|backend|security|images|image <Dockerfile>|dco [base-ref]}" >&2; exit 64 ;;
esac
