# Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=
NUXT_VITE_ALLOWED_HOSTS=

# Standalone Laravel identity API
IDENTITY_API_URL=http://127.0.0.1:8100
IDENTITY_PROJECT=identity-console

# Identity Console confidential BFF client (server-only)
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=

# Optional sandbox project. When present, the default live sign-in page offers
# an instant temporary demo account. If the primary project itself is sandbox,
# the default page provisions the demo automatically and hides live auth forms.
IDENTITY_SANDBOX_API_URL=http://127.0.0.1:8100
IDENTITY_SANDBOX_PROJECT=
IDENTITY_SANDBOX_CLIENT_ID=
IDENTITY_SANDBOX_CLIENT_SECRET=
NUXT_PUBLIC_IDENTITY_SANDBOX_ENABLED=false

# Optional cookie names. Use distinct values for apps sharing a hostname.
IDENTITY_SESSION_COOKIE_NAME=identity-console-session
IDENTITY_CSRF_COOKIE_NAME=identity-console-csrf

# Optional defaults used by @zoltasoft/identity-nuxt/default-pages.
NUXT_PUBLIC_IDENTITY_AUTH_PRODUCT_NAME="Identity Console"
NUXT_PUBLIC_IDENTITY_AUTH_LOGIN_REDIRECT=/admin/projects
NUXT_PUBLIC_IDENTITY_AUTH_LOGOUT_REDIRECT=/admin/sign-in
NUXT_PUBLIC_IDENTITY_AUTH_REGISTER_REDIRECT=/auth/verify-email
