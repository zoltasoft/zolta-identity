{
    "name": "zolta/identity-laravel",
    "description": "Remote-only Laravel consumer for Zolta Identity access tokens and webhooks.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "autoload": {"psr-4": {"Zolta\\Identity\\Laravel\\": "src/"}},
    "extra": {"laravel": {"providers": ["Zolta\\Identity\\Laravel\\IdentityConsumerServiceProvider"]}}
}
